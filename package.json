{
  "name": "lightmapper-web",
  "version": "0.0.1",
  "private": true,
  "description": "Monorepo for the WebGPU port of Godot's lightmapper",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p demos/cornell/tsconfig.json",
    "test": "vitest run",
    "build:demo": "npm run build -w demos/cornell",
    "check:shaders": "cargo run --quiet --manifest-path tools/wgsl-check/Cargo.toml",
    "verify": "npm run typecheck && npm run test && npm run build:demo"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.44",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
